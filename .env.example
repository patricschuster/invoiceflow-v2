# Kopiere diese Datei nach .env und passe die Werte an:
#   cp .env.example .env

# ── Datenbank ─────────────────────────────────────────────────────────────────
# Muss mit POSTGRES_PASSWORD in docker-compose.yml übereinstimmen
DB_PASSWORD=einSicheresPasswort123!

# ── Paperless-ngx DMS-Integration (optional) ─────────────────────────────────
# Ohne Token wird der Folder-Export verwendet
PAPERLESS_URL=http://paperless-vm-ip:8000
PAPERLESS_TOKEN=your_paperless_token_here

# ── Sicherheit ────────────────────────────────────────────────────────────────
# JWT Secret – langen zufälligen String verwenden, z.B.:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change-me-in-production-use-a-long-random-string

# API Key für den File-Watcher (Backend + Watcher müssen identisch sein)
#   python -c "import secrets; print(secrets.token_hex(16))"
WATCHER_API_KEY=change-me-watcher-key

# ── Netzwerk (bei Zugriff von anderen Rechnern setzen) ───────────────────────
# IP oder Hostname des Servers, auf dem InvoiceFlow läuft
# VITE_API_URL=http://192.168.1.10:9500
# CORS_EXTRA_ORIGINS=http://192.168.1.10:3000

# ── Standard-Admin ────────────────────────────────────────────────────────────
# Wird nur beim ersten Start angelegt (danach über Admin-UI ändern)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-admin-password

# ── File-Watcher (automatisch über docker-compose konfiguriert) ───────────────
# Ordner werden unter ./data/ angelegt:
#   incoming/   - neue PDFs hier ablegen (oder vom Scanner/Mail)
#   processing/ - wird vom Watcher verarbeitet
#   error/      - fehlerhafte Dateien landen hier
